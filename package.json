{
  "name": "agrogestor-fruticola",
  "version": "0.9.0",
  "private": true,
  "description": "Protótipo de gestão para fruticultura",
  "main": "electron/main.cjs",
  "scripts": {
    "desktop": "electron .",
    "windows:package": "electron-builder --win nsis",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:prepare": "node scripts/prepare-android.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "br.com.agrogestor.fruticola",
    "productName": "AgroGestor Frutícola",
    "files": [
      "index.html",
      "manifest.webmanifest",
      "icon.svg",
      "sw.js",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
